<Window x:Class="Elektra.UI.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Elektra Security"
        Width="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">
    <Border Padding="28"
            CornerRadius="24"
            Background="#F20B1020"
            BorderBrush="#FFEF4444"
            BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect Color="#FFEF4444" BlurRadius="30" ShadowDepth="0" Opacity="0.34" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="40" Height="48">
                    <Path x:Name="LightningA" Data="M 24,1 L 9,25 L 20,25 L 14,47 L 34,19 L 23,19 Z"
                          Stroke="#FFFF5B5B" StrokeThickness="2.5" Fill="#33FF3030" Stretch="Fill" />
                    <Path x:Name="LightningB" Data="M 24,1 L 9,25 L 20,25 L 14,47 L 34,19 L 23,19 Z"
                          Stroke="#FFFFB4B4" StrokeThickness="1.2" Stretch="Fill" Opacity="0" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderText" Text="SECURE FOLDER ACCESS"
                               Foreground="#FFFF6B6B" FontSize="11" FontWeight="Bold" />
                    <TextBlock x:Name="FolderText" Margin="0,4,0,0"
                               Foreground="White" FontSize="21" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="0,0,0,18" Padding="12"
                    CornerRadius="10" Background="#26EF4444" BorderBrush="#66EF4444" BorderThickness="1">
                <TextBlock x:Name="WarningText" Foreground="#FFFFD5D5" FontSize="13"
                           TextWrapping="Wrap" />
            </Border>

            <TextBlock Grid.Row="2" Text="PASSWORD" Foreground="#FFAAB7D0"
                       FontSize="10" FontWeight="Bold" Margin="2,0,0,6" />
            <PasswordBox x:Name="PasswordInput" Grid.Row="3" Height="44" Padding="12,10"
                         Background="#FF101A2E" Foreground="White" CaretBrush="#FFFB7185"
                         BorderBrush="#FF46536B" BorderThickness="1" FontSize="15"
                         PasswordChanged="OnPasswordChanged" />
            <TextBlock x:Name="ConfirmLabel" Grid.Row="4" Text="CONFIRM PASSWORD"
                       Foreground="#FFAAB7D0" FontSize="10" FontWeight="Bold"
                       Margin="2,12,0,6" Visibility="Collapsed" />
            <PasswordBox x:Name="ConfirmInput" Grid.Row="5" Height="44"
                         Padding="12,10" Background="#FF101A2E" Foreground="White"
                         CaretBrush="#FFFB7185" BorderBrush="#FF46536B" BorderThickness="1"
                         FontSize="15" Visibility="Collapsed" PasswordChanged="OnPasswordChanged" />

            <TextBlock x:Name="StatusText" Grid.Row="6" Margin="2,10,0,0"
                       Foreground="#FFFF8A8A" FontSize="12" TextWrapping="Wrap" />
            <StackPanel Grid.Row="7" Margin="0,22,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="CANCEL" Width="100" Height="38" Margin="0,0,10,0"
                        Background="#FF1D293D" Foreground="#FFE2E8F0" BorderThickness="0"
                        IsCancel="True" Click="OnCancelClicked" />
                <Button x:Name="ContinueButton" Content="CONTINUE" Width="120" Height="38"
                        Background="#FFB91C1C" Foreground="White" FontWeight="Bold"
                        BorderThickness="0" IsEnabled="False" IsDefault="True" Click="OnContinueClicked" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
