<UserControl x:Class="Elektra.UI.Controls.PlasmaSphereControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="260"
             Height="260">

    <Grid x:Name="OrbRoot"
          Width="260"
          Height="260"
          Background="Transparent">
        <Ellipse Width="250"
                 Height="250"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 IsHitTestVisible="False"
                 Stroke="#3385F3FF"
                 StrokeThickness="1.5">
            <Ellipse.Effect>
                <DropShadowEffect Color="#FF38DDF8"
                                  BlurRadius="18"
                                  ShadowDepth="0"
                                  Opacity="0.45" />
            </Ellipse.Effect>
        </Ellipse>

        <Grid x:Name="ShaderSurface"
              Width="240"
              Height="240"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="Transparent"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="SphereScaleTransform"
                                ScaleX="1"
                                ScaleY="1" />
            </Grid.RenderTransform>

            <Ellipse Width="240"
                     Height="240"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.38,0.32"
                                         GradientOrigin="0.32,0.25"
                                         RadiusX="0.72"
                                         RadiusY="0.72">
                        <GradientStop Color="#FFB8F7FF" Offset="0.00" />
                        <GradientStop Color="#FF55DDF7" Offset="0.22" />
                        <GradientStop Color="#FF1687D4" Offset="0.52" />
                        <GradientStop Color="#FF092B74" Offset="0.78" />
                        <GradientStop Color="#FF020817" Offset="1.00" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <DropShadowEffect Color="#FF28DFFF"
                                      BlurRadius="28"
                                      ShadowDepth="0"
                                      Opacity="0.85" />
                </Ellipse.Effect>
            </Ellipse>

            <Ellipse Width="240"
                     Height="240"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.32,0.25"
                                         GradientOrigin="0.32,0.25"
                                         RadiusX="0.55"
                                         RadiusY="0.55">
                        <GradientStop Color="#99FFFFFF" Offset="0.00" />
                        <GradientStop Color="#33FFFFFF" Offset="0.18" />
                        <GradientStop Color="#00FFFFFF" Offset="0.52" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <Ellipse Width="236"
                 Height="236"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 IsHitTestVisible="False"
                 Stroke="#5598F3FF"
                 StrokeThickness="1" />

            <Grid.ContextMenu>
                <ContextMenu Style="{StaticResource ElektraGlassContextMenu}"
                             Opened="OnOrbContextMenuOpened">
                    <MenuItem x:Name="WakeMenuItem"
                              Header="Listen Now (Ask Question)"
                              Style="{StaticResource ElektraGlassMenuItem}"
                              Click="OnWakeClicked" />

                    <MenuItem x:Name="StopSpeakingMenuItem"
                              Header="Stop Speaking"
                              Style="{StaticResource ElektraGlassMenuItem}"
                              Click="OnStopSpeakingClicked" />

                    <Separator Style="{StaticResource ElektraGlassSeparator}" />

                    <MenuItem x:Name="MicrophoneSubMenu"
                              Header="Microphone Input"
                              Style="{StaticResource ElektraGlassMenuItem}"
                              SubmenuOpened="OnMicrophoneSubmenuOpened" />

                    <Separator Style="{StaticResource ElektraGlassSeparator}" />

                    <MenuItem Header="Hide to Tray"
                              InputGestureText="Win+Alt+E"
                              Style="{StaticResource ElektraGlassMenuItem}"
                              Click="OnHideClicked" />

                    <MenuItem Header="Exit Elektra"
                              Style="{StaticResource ElektraGlassMenuItem}"
                              Click="OnExitClicked" />
                </ContextMenu>
            </Grid.ContextMenu>
    </Grid>
</UserControl>
